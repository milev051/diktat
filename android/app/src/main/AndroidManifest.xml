<?xml version="1.0" encoding="utf-8"?>
<!--
  Probna aplikacija: prijavljuje se na CETIRI razlicita mesta u sistemu.
  Svako od njih vraca svoj marker, pa se po tekstu koji stigne tacno zna
  koji mehanizam radi na ovom telefonu.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="Diktat proba"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Diktat proba">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A: RecognitionService — treba da se pojavi u biraču "Voice input"
             pored "Samsung voice input" i "Google voice input". -->
        <service
            android:name=".ProbeRecognitionService"
            android:exported="true"
            android:label="Diktat proba (A)"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- B: glasovni IME — pojavljuje se u listi tastatura. -->
        <service
            android:name=".ProbeInputMethodService"
            android:exported="true"
            android:label="Diktat proba (B)"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- C: digitalni asistent — bocni taster. Providna tema da se vidi
             da li ostaje preko aplikacije ili je izbacuje iz fokusa. -->
        <activity
            android:name=".AssistActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Diktat proba (C)"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- E: plocica u brzim podesavanjima. -->
        <service
            android:name=".ProbeTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="Diktat proba (E)"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
