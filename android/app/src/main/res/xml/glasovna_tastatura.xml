<?xml version="1.0" encoding="utf-8"?>
<!-- Isto kao Google Voice Typing: jedan pomocni glasovni podtip, bez jezika.
     Po `imeSubtypeMode="voice"` je Samsung tastatura nudi pod „Voice input",
     a `isAuxiliary` je sklanja iz obicne liste tastatura. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="studio.room211.diktat.MainActivity"
    android:supportsSwitchingToNextInputMethod="false">
    <subtype
        android:label="@string/glasovna_tastatura"
        android:imeSubtypeMode="voice"
        android:isAuxiliary="true"
        android:overridesImplicitlyEnabledSubtype="true" />
</input-method>
